meta {
  name: 15 - Erro - card inexistente
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/pessoas/{{cardId}}
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

docs {
  O card acabou de ser apagado: agora a API responde 404. O mesmo acontece
  com um card de outro pipe, que a API nunca altera.
}
